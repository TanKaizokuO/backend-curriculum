# Copy this file to .env and fill in real values.
#
#     cp .env.example .env
#
# Commit this file. Never commit .env.

DATABASE_URL=postgresql://learner:lesson4@localhost:55432/bookmarks

# Lesson 10. A cache that can be wrong, so it gets a short TTL.
REDIS_URL=redis://localhost:6379/0

# Generate your own. Never reuse this value.
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
SECRET_KEY=replace-me-with-64-hex-characters-from-the-command-above

APP_ENV=development
LOG_LEVEL=info
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10
# How long a request waits for a pooled database connection before it gives
# up and answers 503. Long: a slow database queues every request behind it.
# Short: a request that cannot get a connection fails fast.
POOL_ACQUIRE_TIMEOUT_SECONDS=2.0

# A token cannot be withdrawn, so keep the window short.
TOKEN_TTL_MINUTES=15
# A session can be withdrawn, so the window may be long.
SESSION_TTL_MINUTES=10080
# bcrypt work factor. Raise it until a login costs about 250 ms on your server.
BCRYPT_ROUNDS=12

# "local" counts login attempts in this process's memory, and breaks with
# more than one instance. "redis" counts them in Redis, shared by every
# instance. See rate_limit.py.
RATE_LIMIT_BACKEND=redis
