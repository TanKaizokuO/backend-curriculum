# Copy this file to .env and fill in a real value.
#
#     cp .env.example .env
#
# Commit this file. Never commit .env.
# The names are the contract. The values belong to one deploy only.

POSTGRES_PASSWORD=change-me

# The API reads this one. compose.yaml builds it from POSTGRES_PASSWORD, so
# you only need it when you run uvicorn outside a container.
# DATABASE_URL=postgresql://learner:change-me@localhost:55432/bookmarks

APP_ENV=development
LOG_LEVEL=info
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10
