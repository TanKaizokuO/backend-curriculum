# Copy this file to .env and fill in real values.
#
#     cp .env.example .env
#
# Commit this file. Never commit .env.

DATABASE_URL=postgresql://learner:lesson4@localhost:55432/bookmarks

# Generate your own. Never reuse this value.
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
SECRET_KEY=replace-me-with-64-hex-characters-from-the-command-above

APP_ENV=development
LOG_LEVEL=info
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# A token cannot be withdrawn, so keep the window short.
TOKEN_TTL_MINUTES=15
# A session can be withdrawn, so the window may be long.
SESSION_TTL_MINUTES=10080
# bcrypt work factor. Raise it until a login costs about 250 ms on your server.
BCRYPT_ROUNDS=12
