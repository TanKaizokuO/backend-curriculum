# Copy this file to .env and fill in real values.
#
#     cp .env.example .env
#
# Commit this file. Never commit .env.

DATABASE_URL=postgresql://learner:lesson4@localhost:55432/bookmarks

# Lesson 10. A cache that can be wrong, so it gets a short TTL.
REDIS_URL=redis://localhost:6379

# Generate your own. Never reuse this value.
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
SECRET_KEY=replace-me-with-64-hex-characters-from-the-command-above

NODE_ENV=development
PORT=8030
TOKEN_TTL_MINUTES=15
SESSION_TTL_MINUTES=10080
BCRYPT_ROUNDS=12

# How many connections one instance's pool may hold open at once, and how
# long a request waits for one before it gives up and answers 503. Long
# timeout: a slow database queues every request behind it. Short: a
# request that cannot get a connection fails fast.
POOL_MAX_SIZE=10
POOL_ACQUIRE_TIMEOUT_SECONDS=2.0

# "local" counts login attempts in this process's memory, and breaks with
# more than one instance. "redis" counts them in Redis, shared by every
# instance. See rateLimit.ts.
RATE_LIMIT_BACKEND=redis
